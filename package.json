{
  "name": "@vastblast/node-minify",
  "version": "2.1.3",
  "description": "",
  "scripts": {
    "build": "(npm run build:go || bun run build:go) && tsdown",
    "build:go": "node ./scripts/build-go.mjs || bun ./scripts/build-go.mjs",
    "build:ts": "tsdown",
    "postinstall": "npm run build:go || bun run build:go"
  },
  "keywords": [],
  "author": "VastBlast",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist/",
    "build/",
    "minify/",
    "scripts/"
  ],
  "type": "module",
  "dependencies": {
    "koffi": "^2.14.1"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "tsdown": "^0.17.0-beta.3",
    "typescript": "^5.6.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VastBlast/node-minify.git"
  }
}